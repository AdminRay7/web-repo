# ══════════════════════════════════════════════════════════════
#  303-XMD — Web Panel (Repo B)
# ══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# ── Bot server ───────────────────────────────────────────────
# In production this should be an internal address (loopback,
# Docker network, or private VPS IP) — NEVER the public domain.
BOT_API_URL=http://127.0.0.1:4000
INTERNAL_API_KEY=change-this-to-the-same-key-as-bot-env

# ── Public API protection ────────────────────────────────────
# If set, /pair, /status, /config, /reload require x-api-key.
# Leave empty to make the panel public.
PAIR_API_KEY=

# ── Rate limits (ms per IP) ──────────────────────────────────
RATE_LIMIT_MS=60000
STATUS_RATE_MS=30000
